# Example only. Copy to .github/workflows/ in your fork to enable.
name: nightly-agent

on:
  schedule:
    - cron: '0 18 * * *'   # 18:00 UTC = 02:00 Asia/Shanghai
  workflow_dispatch:
    inputs:
      task:
        description: 'Task for the agent'
        required: false
        default: 'Pick the first unchecked item in docs/experiments/02-ralph/fix_plan.md'

permissions:
  contents: write
  pull-requests: write

jobs:
  agent:
    runs-on: ubuntu-latest
    timeout-minutes: 60          # hard stop
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: maven
      - name: Run agent loop (replace with your CLI)
        env:
          AGENT_API_KEY: ${{ secrets.AGENT_API_KEY }}
          TASK: ${{ github.event.inputs.task || 'Pick the first unchecked item in docs/experiments/02-ralph/fix_plan.md' }}
        run: |
          git switch -c "agent/nightly-${{ github.run_id }}"
          # e.g. npm i -g <your-agent-cli> && <your-agent-cli> -p "$TASK"
          echo "TODO: install and run your agent CLI here"
          MAX_ITERS=5 MAX_MINUTES=45 bash docs/experiments/07-budget-caps/loop-with-brakes.sh || true
      - name: Verify before opening PR
        run: ./mvnw -B verify && scripts/check-test-integrity.sh origin/main
      - name: Open PR for human review
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          git config user.name "nightly-agent"
          git config user.email "nightly-agent@users.noreply.github.com"
          git push -u origin HEAD
          gh pr create --fill --label agent || true
